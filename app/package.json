{
  "name": "lumen-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:test": "ANALYZE=true NEXT_PUBLIC_E2E=1 next build",
    "start": "next start",
    "start:test": "NEXT_PUBLIC_E2E=1 next start -p 3100",
    "lint": "next lint && prettier --check \"src/**/*.{ts,tsx,md,json}\" && eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,md,json}\"",
    "typecheck": "tsc --noEmit",
    "secrets:scan": "gitleaks protect --staged --redact --no-banner",

    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:check": "vitest run --coverage --reporter=default",

    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:debug": "playwright test --debug",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots",

    "test:a11y": "playwright test tests/accessibility",
    "test:perf": "playwright test tests/performance && vitest run tests/performance",
    "test:security": "playwright test tests/security",
    "test:reliability": "playwright test tests/reliability",

    "lighthouse": "lhci autorun",
    "size": "size-limit",
    "pa11y": "pa11y-ci --config .pa11yci.json",

    "test:all": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:e2e:smoke && pnpm test:a11y && pnpm test:perf && pnpm test:security && pnpm test:visual",
    "test:ci": "pnpm test:unit --reporter=junit && pnpm test:integration --reporter=junit && pnpm test:e2e:smoke",

    "metrics:aggregate": "node scripts/aggregate-metrics.mjs",
    "flake:report": "node scripts/flake-report.mjs"
  },
  "dependencies": {
    "next": "15.x",
    "react": "19.x",
    "react-dom": "19.x",
    "@tanstack/react-query": "5.x",
    "zustand": "5.x",
    "zod": "3.x",
    "react-hook-form": "7.x",
    "@hookform/resolvers": "3.x",
    "next-intl": "3.x",
    "@radix-ui/react-dialog": "1.x",
    "@radix-ui/react-dropdown-menu": "2.x",
    "@radix-ui/react-tooltip": "1.x",
    "@radix-ui/react-toast": "1.x",
    "@radix-ui/react-tabs": "1.x",
    "@radix-ui/react-accordion": "1.x",
    "@radix-ui/react-popover": "1.x",
    "@radix-ui/react-select": "2.x",
    "lucide-react": "0.x",
    "class-variance-authority": "0.x",
    "clsx": "2.x",
    "tailwind-merge": "2.x",
    "date-fns": "3.x",
    "nanoid": "5.x"
  },
  "devDependencies": {
    "typescript": "5.x",
    "@types/react": "19.x",
    "@types/react-dom": "19.x",
    "@types/node": "22.x",
    "eslint": "9.x",
    "eslint-config-next": "15.x",
    "prettier": "3.x",
    "vitest": "2.x",
    "@vitejs/plugin-react": "4.x",
    "happy-dom": "15.x",
    "@testing-library/react": "16.x",
    "@testing-library/jest-dom": "6.x",
    "@testing-library/user-event": "14.x",
    "vitest-axe": "0.x",
    "axe-core": "4.x",
    "msw": "2.x",
    "fast-check": "3.x",
    "@playwright/test": "1.48.x",
    "@axe-core/playwright": "4.x",
    "size-limit": "11.x",
    "@lhci/cli": "0.14.x",
    "pa11y-ci": "3.x",
    "gitleaks": "8.x",
    "husky": "9.x",
    "lint-staged": "15.x",
    "commitlint": "19.x"
  }
}
